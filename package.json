{
    "name": "obsidian-e2e-toolkit",
    "version": "1.6.0",
    "description": "Reusable E2E testing utilities for Obsidian plugins using Playwright",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./coverage": {
            "import": {
                "types": "./dist/coverage.d.mts",
                "default": "./dist/coverage.mjs"
            },
            "require": {
                "types": "./dist/coverage.d.cts",
                "default": "./dist/coverage.cjs"
            }
        },
        "./esm": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./cjs": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "scripts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "prepare": "pnpm run build",
        "build": "tsdown",
        "test": "node --test scripts/*.test.mjs",
        "release": "release-it",
        "prepublishOnly": "pnpm run build",
        "test:e2e:example": "pnpm playwright test example/example.spec.ts",
        "test:e2e:readiness": "playwright test --config playwright.readiness.config.ts",
        "test:e2e:coverage": "playwright test --config playwright.coverage.config.ts",
        "test:e2e:on-demand": "pnpm playwright test example/on-demand-plugins/tests",
        "test:e2e:runtime": "playwright test --config playwright.runtime.config.ts",
        "pack:local": "node scripts/pack-local.mjs",
        "postinstall": "node ./scripts/postinstall.cjs"
    },
    "author": "22-2",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/22-2/obsidian-e2e-toolkit.git"
    },
    "bugs": {
        "url": "https://github.com/22-2/obsidian-e2e-toolkit/issues"
    },
    "homepage": "https://github.com/22-2/obsidian-e2e-toolkit#readme",
    "keywords": [
        "obsidian",
        "e2e",
        "testing",
        "playwright",
        "plugin"
    ],
    "peerDependencies": {
        "@playwright/test": "^1.56.0",
        "electron": "*",
        "playwright": "^1.56.0"
    },
    "dependencies": {
        "@electron/asar": "^4.3.0",
        "acorn": "^8.19.0",
        "ast-v8-to-istanbul": "^1.0.7",
        "chalk": "^6.0.0",
        "es-toolkit": "^1.52.0",
        "extract-zip": "^2.0.1",
        "find-up": "^8.0.0",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "loglevel": "^1.9.2",
        "loglevel-plugin-prefix": "^0.8.4",
        "tar": "^7.5.22",
        "tiny-invariant": "^1.3.3"
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^12.0.2",
        "@types/istanbul-lib-coverage": "^2.0.6",
        "@types/istanbul-lib-report": "^3.0.3",
        "@types/istanbul-reports": "^3.0.4",
        "@types/node": "^26.6.2",
        "esbuild": "^0.28.2",
        "glob": "^13.0.6",
        "obsidian": "^1.13.1",
        "playwright": "^1.63.0",
        "release-it": "^21.1.0",
        "tsdown": "^0.23.0",
        "typescript": "npm:@typescript/typescript6"
    },
    "engines": {
        "node": ">=23.0.0"
    },
    "bin": {
        "obsidian-e2e-toolkit": "./scripts/init.mjs"
    }
}
