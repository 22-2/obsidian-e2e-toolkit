{
  "name": "obsidian-e2e-toolkit",
  "version": "0.1.1",
  "description": "Reusable E2E testing utilities for Obsidian plugins using Playwright",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm run build",
    "test:e2e:example": "pnpm playwright test example/example.spec.ts",
    "test:e2e:vfe": "pnpm playwright test example/drag-and-drop.spec.ts",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepare": "pnpm run build"
  },
  "author": "22-2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-2/obsidian-e2e-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/22-2/obsidian-e2e-toolkit/issues"
  },
  "homepage": "https://github.com/22-2/obsidian-e2e-toolkit#readme",
  "keywords": [
    "obsidian",
    "e2e",
    "testing",
    "playwright",
    "plugin"
  ],
  "peerDependencies": {
    "@playwright/test": "^1.56.0",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@electron/asar": "^4.0.1",
    "chalk": "^5.6.2",
    "es-toolkit": "^1.44.0",
    "extract-zip": "^2.0.1",
    "find-up": "^8.0.0",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "tar": "^7.5.7",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "electron": "^40.1.0",
    "esbuild": "^0.27.2",
    "glob": "^13.0.1",
    "obsidian": "^1.11.4",
    "obsidian-typings": "^4.93.0",
    "playwright": "^1.58.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=23.0.0"
  }
}
